{
  // Used by TypeDoc (npm run docs): only the TypeScript modules, since plain tsc can't read .vue files.
  // The components are documented by scripts/docs-components.mjs.
  "extends": "./tsconfig.app.json",
  "include": [
    "env.d.ts",
    "env.docs.d.ts",
    "src/main.ts",
    "src/core/**/*.ts",
    "src/adapters/**/*.ts",
    "src/ui/**/*.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "tsBuildInfoFile": null
  }
}
