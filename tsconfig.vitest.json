// Type-checks the unit tests in tests/, which import the app through the @/ alias.
{
  "extends": "./tsconfig.app.json",
  "include": ["tests/**/*", "env.d.ts"],
  "exclude": [],
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
