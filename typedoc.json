{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Discours",
  "entryPoints": [
    "src/main.ts",
    "src/core/**/*.ts",
    "src/adapters/**/*.ts",
    "src/ui/**/*.ts"
  ],
  "tsconfig": "tsconfig.docs.json",
  "out": "docs/api",
  "readme": "README.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "sort": [
    "source-order"
  ],
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": true
  },
  "ignoredHighlightLanguages": [
    "mermaid"
  ],
  "projectDocuments": [
    "CONTRIBUTING.md",
    "docs/components.md"
  ],
  "treatWarningsAsErrors": false,
  "exclude": [
    "**/vendor/*.js"
  ]
}
