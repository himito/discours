{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Discours",
  "entryPoints": [
    "src/main.ts",
    "src/router/index.ts",
    "src/phonetics/analyze.ts",
    "src/phonetics/normalize.ts",
    "src/phonetics/numbers.ts",
    "src/phonetics/lexicon.ts",
    "src/phonetics/espeak.ts",
    "src/phonetics/espeak.worker.ts",
    "src/practice/align.ts",
    "src/practice/units.ts",
    "src/practice/dictionary.ts",
    "src/composables/useSpeech.ts",
    "src/composables/useRecognition.ts",
    "src/stores/discours.ts",
    "src/pdf.ts",
    "src/vendor/espeak-ng-fr.d.ts"
  ],
  "tsconfig": "tsconfig.docs.json",
  "out": "docs/api",
  "readme": "README.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "sort": [
    "source-order"
  ],
  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": true
  },
  "ignoredHighlightLanguages": [
    "mermaid"
  ],
  "projectDocuments": [
    "docs/components.md"
  ],
  "treatWarningsAsErrors": false
}
